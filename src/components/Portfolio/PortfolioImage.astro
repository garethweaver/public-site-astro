---
import { imagekit } from '../../utils/imagekit'
import type { PortfolioItem } from './PortfolioList.astro'

const { item, lazy } = Astro.props
const thumb = item.frontmatter.thumb?.url

export interface Props {
  item: PortfolioItem
  lazy: boolean
}
---

<img
  src={imagekit(thumb, ['w-375'])}
  srcset={`${imagekit(thumb, ['w-375'])} 1x, ${imagekit(thumb, ['w-750'])} 2x`}
  width="375"
  height="281"
  loading={lazy ? 'lazy' : 'eager'}
  alt={item.frontmatter.title}
/>

<style lang="sass">
img
  display: block
  width: 100%
  height: auto
</style>
